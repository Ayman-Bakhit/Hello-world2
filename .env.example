# Copy to .env (git-ignored). NEVER commit real values. Secrets stay server-side only.
NODE_ENV=development

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_name
REDIS_URL=redis://localhost:6379

# ---- API (apps/api) ----
PORT=4000
HOST=127.0.0.1
# Exact origins only, comma separated. No wildcard.
CORS_ORIGINS=http://localhost:3000
# disabled (default): no way to obtain a session, protected routes return 401.
# dev-insecure: enables POST /api/auth/dev-session for the seeded DEMO user with NO wallet signature.
#   Local development only. The API refuses to start with this value when NODE_ENV=production.
AUTH_MODE=dev-insecure
SESSION_TTL_HOURS=12
RATE_LIMIT_MAX=120
RATE_LIMIT_WRITE_MAX=20
RATE_LIMIT_WINDOW=1 minute
LOG_LEVEL=info
# Set true only behind a trusted reverse proxy.
TRUST_PROXY=false

# ---- Frontend (apps/web). Put these in apps/web/.env.local ----
# mock (default): data from shared demo fixtures, no network.  api: calls the API below.
# NEXT_PUBLIC_API_MODE=mock
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ---- Future (not used yet) ----
# Solana: use devnet/testnet until audits are done. Keys stay server-side.
SOLANA_CLUSTER=devnet
RPC_URL=
INDEXER_API_KEY=
PRICE_API_KEY=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
ENCRYPTION_KEY=
# Public addresses only. Never put a private key here.
ADMIN_WALLET=
TREASURY_WALLET=
CHARITY_REGISTRY_CONFIG=./config/charities.json
