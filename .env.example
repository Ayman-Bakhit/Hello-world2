# Copy to .env. NEVER commit real values. Secrets stay server-side only.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_name
REDIS_URL=redis://localhost:6379
# Solana: use devnet/testnet until audits are done. Keys stay server-side.
SOLANA_CLUSTER=devnet
RPC_URL=
INDEXER_API_KEY=
PRICE_API_KEY=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
ENCRYPTION_KEY=
# Public addresses only. Never put a private key here.
ADMIN_WALLET=
TREASURY_WALLET=
CHARITY_REGISTRY_CONFIG=./config/charities.json
