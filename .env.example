# Copy to .env (git-ignored). NEVER commit real values. Secrets stay server-side only.
NODE_ENV=development

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_name
REDIS_URL=redis://localhost:6379

# ---- API (apps/api) ----
PORT=4000
HOST=127.0.0.1
# Exact origins only, comma separated. No wildcard.
CORS_ORIGINS=http://localhost:3000
# wallet (default): Solana wallet-signature sign-in only.
# dev-insecure: ALSO enables POST /api/auth/dev-session, a bearer session for the seeded DEMO user with
#   NO wallet signature (useful to exercise the demo-backed endpoints). Local development only: the API
#   refuses to start with this value when NODE_ENV=production and ignores dev sessions there.
AUTH_MODE=wallet
# Origin of the web app users sign in to; must be one of CORS_ORIGINS. Defaults to the first CORS origin.
# The sign-in message's domain is derived from it.
# AUTH_ORIGIN=http://localhost:3000
# Solana network named in the sign-in message (Chain ID): devnet | testnet | mainnet
SOLANA_CLUSTER=devnet
# Sign-in challenge lifetime (60-900 seconds) and max unused challenges per wallet address.
NONCE_TTL_SECONDS=300
MAX_OPEN_NONCES_PER_ADDRESS=10
SESSION_TTL_HOURS=12
# Session cookie: HttpOnly always; SameSite strict|lax; Secure (and __Host- prefixed) always in production.
# Set COOKIE_SECURE=true in development only if you serve over https.
COOKIE_SAMESITE=strict
COOKIE_SECURE=false
RATE_LIMIT_MAX=120
RATE_LIMIT_WRITE_MAX=20
RATE_LIMIT_WINDOW=1 minute
LOG_LEVEL=info
# Set true only behind a trusted reverse proxy.
TRUST_PROXY=false

# ---- Frontend (apps/web). Put these in apps/web/.env.local ----
# mock (default): data from shared demo fixtures, no network.  api: calls the API below.
# NEXT_PUBLIC_API_MODE=mock
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ---- Solana indexing (Slice 5, READ-ONLY) ----
# Server-side only. The URL may embed a provider API key: never commit a real one, never use a NEXT_PUBLIC_ variable.
# Empty = indexing disabled (real wallets stay "NO LIVE DATA YET"; demo data is unaffected).
# Use a devnet URL while developing. https is required in production (http only for localhost).
SOLANA_RPC_URL=
# finalized (default, safest) | confirmed
# SOLANA_COMMITMENT=finalized
# SOLANA_RPC_TIMEOUT_MS=10000
# Bounded sync. First sync indexes at most INITIAL most recent transactions; later syncs at most MAX_PER_SYNC.
# INDEXER_INITIAL_TRANSACTION_LIMIT=50
# INDEXER_MAX_TRANSACTIONS_PER_SYNC=100
# INDEXER_MAX_TOKEN_ACCOUNTS=500
# INDEXER_MAX_METADATA_LOOKUPS=25
# Hard ceiling on RPC calls and wall-clock time in one sync, whatever else is configured.
# INDEXER_MAX_RPC_CALLS_PER_SYNC=400
# INDEXER_MAX_RUN_SECONDS=120
# Per-wallet cooldown between syncs, concurrent syncs allowed, per-IP sync requests per window.
# INDEXER_MIN_SYNC_INTERVAL_SECONDS=30
# INDEXER_MAX_CONCURRENT_SYNCS=2
# INDEXER_SYNC_RATE_LIMIT_MAX=5
# Start a bounded background sync after a successful wallet sign-in.
# INDEXER_SYNC_ON_LOGIN=true

# ---- Prices (Slice 5) ----
# none (default): no prices, assets show PRICE DATA UNAVAILABLE. coingecko: SOL/USD only, and only when SOLANA_CLUSTER=mainnet.
# SPL tokens are never priced by guesswork. PRICE_API_URL example: https://api.coingecko.com/api/v3
# PRICE_PROVIDER=none
# PRICE_API_URL=
# PRICE_API_KEY=
# A price older than this is labeled stale.
# PRICE_MAX_AGE_SECONDS=900

# ---- Tax data (Slice 6) ----
# A stored price counts for a transaction only if observed at most this many seconds before it (no look-ahead).
# TAX_PRICE_MAX_AGE_SECONDS=3600
# Cap on transactions read for one tax calculation; beyond it the result is marked incomplete.
# TAX_MAX_TRANSACTIONS=5000

# ---- Future (not used yet) ----
# Generate with: openssl rand -hex 32
SESSION_SECRET=
ENCRYPTION_KEY=
# Public addresses only. Never put a private key here.
ADMIN_WALLET=
TREASURY_WALLET=
CHARITY_REGISTRY_CONFIG=./config/charities.json
