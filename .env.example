# Copy to .env (git-ignored). NEVER commit real values. Secrets stay server-side only.
NODE_ENV=development

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_name
REDIS_URL=redis://localhost:6379

# ---- API (apps/api) ----
PORT=4000
HOST=127.0.0.1
# Exact origins only, comma separated. No wildcard.
CORS_ORIGINS=http://localhost:3000
# wallet (default): Solana wallet-signature sign-in only.
# dev-insecure: ALSO enables POST /api/auth/dev-session, a bearer session for the seeded DEMO user with
#   NO wallet signature (useful to exercise the demo-backed endpoints). Local development only: the API
#   refuses to start with this value when NODE_ENV=production and ignores dev sessions there.
AUTH_MODE=wallet
# Origin of the web app users sign in to; must be one of CORS_ORIGINS. Defaults to the first CORS origin.
# The sign-in message's domain is derived from it.
# AUTH_ORIGIN=http://localhost:3000
# Solana network named in the sign-in message (Chain ID): devnet | testnet | mainnet
SOLANA_CLUSTER=devnet
# Sign-in challenge lifetime (60-900 seconds) and max unused challenges per wallet address.
NONCE_TTL_SECONDS=300
MAX_OPEN_NONCES_PER_ADDRESS=10
SESSION_TTL_HOURS=12
# Session cookie: HttpOnly always; SameSite strict|lax; Secure (and __Host- prefixed) always in production.
# Set COOKIE_SECURE=true in development only if you serve over https.
COOKIE_SAMESITE=strict
COOKIE_SECURE=false
RATE_LIMIT_MAX=120
RATE_LIMIT_WRITE_MAX=20
RATE_LIMIT_WINDOW=1 minute
LOG_LEVEL=info
# Set true only behind a trusted reverse proxy.
TRUST_PROXY=false

# ---- Frontend (apps/web). Put these in apps/web/.env.local ----
# mock (default): data from shared demo fixtures, no network.  api: calls the API below.
# NEXT_PUBLIC_API_MODE=mock
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ---- Future (not used yet) ----
# Solana: use devnet/testnet until audits are done. Keys stay server-side.
RPC_URL=
INDEXER_API_KEY=
PRICE_API_KEY=
# Generate with: openssl rand -hex 32
SESSION_SECRET=
ENCRYPTION_KEY=
# Public addresses only. Never put a private key here.
ADMIN_WALLET=
TREASURY_WALLET=
CHARITY_REGISTRY_CONFIG=./config/charities.json
